# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
/loopze

# Generated Windows resource files (icon + version info).
# The .ico is committed; .syso files are produced by goversioninfo on each build.
*.syso

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
*.prof

# Go workspace file
go.work
go.work.sum

# Dependency directories
vendor/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# LOOPZE build artifacts
/bin/
/build/
/dist/
/tmp/

# LOOPZE data directory (runtime)
/data/

# Encryption key files – NEVER commit these
*.key

# Embedded frontend build output (keep the gitkeep)
/web/dist/*
!/web/dist/.gitkeep

# Environment files
.env
.env.local
.env.*.local

# Debug logs
*.log

# mkdocs build output and venv
/site/
/.venv-docs/

# Python venvs / caches inside demo servers
/demo/s7-server/.venv/
/demo/**/__pycache__/

# Ignore Claude config
/.claude/
