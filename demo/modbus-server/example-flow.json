          ],
          "config": {
            "outputs": 1,
            "func": "// modbus-read (FC3 raw) gives us BOTH representations:\n//   msg.payload → [reg0, reg1]            uint16 word array\n//   msg.bytes   → [b0, b1, b2, b3]        uint8 wire bytes\n// For the Buffer API we use msg.bytes directly — no register-to-byte conversion needed.\nconst buf = Buffer.from(msg.bytes);\n\nmsg.payload = buf.readFloatBE(0);\nmsg.topic   = 'temperature';\nreturn msg;\n"
          }
        },
        {
