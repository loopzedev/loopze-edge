{
  "name": "loopze-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:dashboard": "vite --config vite.dashboard.config.ts",
    "build:editor": "vue-tsc --noEmit && vite build",
    "build:dashboard": "vite build --config vite.dashboard.config.ts",
    "build": "npm run build:editor && npm run build:dashboard",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.tsx",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3",
    "@vue-flow/controls": "^1.1",
    "@vue-flow/core": "^1.41",
    "@vue-flow/minimap": "^1.5",
    "cron-parser": "^5.5.0",
    "cronstrue": "^3.14.0",
    "monaco-editor": "^0.55.1",
    "pinia": "^3.0",
    "radix-vue": "^1.9",
    "vue": "^3.5",
    "vue-router": "^4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2",
    "autoprefixer": "^10.4",
    "postcss": "^8.5",
    "tailwindcss": "^3.4",
    "typescript": "^5.7",
    "vite": "^6.1",
    "vue-tsc": "^2.2"
  }
}
